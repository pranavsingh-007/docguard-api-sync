{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "mvn -q -DskipTests compile",
        "powershell": "mvn -q -DskipTests compile",
        "cwd": ".",
        "timeoutSec": 120
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "mvn -q test",
        "powershell": "mvn -q test",
        "cwd": ".",
        "timeoutSec": 300
      },
      {
        "type": "command",
        "bash": "mvn -q package",
        "powershell": "mvn -q package",
        "cwd": ".",
        "timeoutSec": 300
      },
      {
        "type": "command",
        "bash": "java -jar target/docguard-0.1.0-SNAPSHOT.jar --help",
        "powershell": "java -jar target/docguard-0.1.0-SNAPSHOT.jar --help",
        "cwd": ".",
        "timeoutSec": 60
      }
    ]
  }
}